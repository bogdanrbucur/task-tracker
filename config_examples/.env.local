M365_TENANT_ID="00000000-0000-0000-0000-000000000000"
M365_CLIENT_ID="00000000-0000-0000-0000-000000000000"
M365_CLIENT_SECRET=""
PASSWORD_AUTH_ENABLED=true  # set to false to retire the email/password form and require M365
