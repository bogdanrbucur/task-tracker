{
	"name": "task-tracker",
	"version": "1.13.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev-test": "dotenv -e .env.test -e .env.local -- sh -c 'npx prisma migrate deploy && NEXT_DIST_DIR=.next-test next dev -p 3535'",
		"build": "next build",
		"email-worker": "dotenv -e .env -- tsx ./lib/email-worker.ts",
		"start": "dotenv -e .env.local -- sh -c 'next start -p $PORT'",
		"lint": "eslint .",
		"daily": "tsx ./lib/dailyTasks.ts",
		"hashpass": "tsx ./lib/hashpass.ts",
		"check": "tsc --noEmit",
		"test": "start-server-and-test dev-test http://localhost:3535 playwright:test",
		"playwright:test": "playwright test"
	},
